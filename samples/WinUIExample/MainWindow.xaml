<Window
	x:Class="WinUIExample.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="MsGraphMcpProvider Example">
	<StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
		<TextBlock Text="MsGraphMcpProvider WinUI example" Style="{StaticResource TitleTextBlockStyle}" />
		<NumberBox x:Name="PortBox" Header="MCP port (loopback only)" Value="5123"
				   Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden" />
		<TextBox x:Name="ClientIdBox" Header="Client Id" />
		<TextBox x:Name="TenantIdBox" Header="Tenant Id (leave empty for 'organizations')" />
		<CheckBox x:Name="DeviceCodeCheck" Content="Use device code sign-in (Client Id only; no Windows broker)" IsChecked="True" />
		<CheckBox x:Name="WriteCheck" Content="Allow posting channel messages" IsChecked="True" />
		<Button x:Name="ToggleButton" Content="Start MCP server" Click="ToggleButton_Click" />
		<Button x:Name="SignInButton" Content="Sign in (device code)" Click="SignInButton_Click" IsEnabled="False" />
		<TextBlock x:Name="StatusText" Text="Server stopped." TextWrapping="Wrap" />
				<StackPanel x:Name="CodePanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
					<TextBlock x:Name="CodeText" FontWeight="Bold" FontSize="24" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
					<Button x:Name="CopyCodeButton" Content="Copy code" Click="CopyCodeButton_Click" />
				</StackPanel>
	</StackPanel>
</Window>
